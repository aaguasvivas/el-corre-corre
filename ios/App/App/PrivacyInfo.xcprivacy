<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's privacy manifest, for the game's own code and the Capacitor
     plugins without a manifest of their own. The game's code collects
     nothing and tracks nobody. The ads (Google Mobile Ads and its consent
     SDK, from release 1.0) ship their own privacy manifests, which declare
     what they collect; App Store Connect's App Privacy answers must cover
     them (docs/audit/ADS-PLAN.md, owner step 4). The purchase plugin
     (StoreKit) and the AdMob plugin use no required-reason API. Two
     plugins use APIs Apple requires a reason for, and the app declares them:
     - @capacitor/preferences keeps the save backup in UserDefaults, read
       and written only by this app (CA92.1).
     - @capacitor/filesystem and its IONFilesystemLib can read file
       timestamps; the game only writes the share card into its own cache
       (C617.1: files inside the app container).
     Data types and tracking stay empty here on purpose: Google's two
     manifests declare them for their own code, and repeating them here
     would double-declare. The list of every manifest in the built app is in
     RELEASE.md ("App Privacy answers"). -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
